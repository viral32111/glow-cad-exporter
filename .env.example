# The minimum level of logs to print
GLOW_LOG_LEVEL = "info"

###################################

# The IP address & TCP port to listen for HTTP requests on
GLOW_HTTP_ADDRESS = "127.0.0.1"
GLOW_HTTP_PORT = 5000

# The HTTP path to expose Prometheus metrics on
GLOW_METRICS_PATH = "/metrics"

# Whether to also expose metrics for the Go process
GLOW_METRICS_GO_BUILTIN = false

###################################

# The IP address & TCP port to listen for MQTT messages on
GLOW_MQTT_ADDRESS = "127.0.0.1"
GLOW_MQTT_PORT = 1883

# The credentials for authenticating MQTT connections
GLOW_MQTT_USER = null
GLOW_MQTT_PASSWORD = null

# The prefix for topics published by the Glow CAD
GLOW_MQTT_TOPIC = "glow"

###################################

# The URL to the Redis server for caching MQTT messages
GLOW_REDIS_URL = "redis://default@127.0.0.1:6379/0"

# The prefix for Redis keys to avoid collisions
GLOW_REDIS_KEY_PREFIX = "glow"

# How long to cache MQTT messages for in Redis
GLOW_REDIS_STATE_TTL = "24h" # 1 day
GLOW_REDIS_ELECTRIC_TTL = "730h" # 1 month
GLOW_REDIS_GAS_TTL = "730h" # 1 month
